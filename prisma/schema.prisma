// Portfolio CMS — database schema.
// See docs/ARCHITECTURE.md §7 for the rationale behind each model.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  ADMIN
  EDITOR
}

/// IMPORTED = page written elsewhere (added by URL). WRITTEN = written in the Notebook editor.
enum ContentSource {
  IMPORTED
  WRITTEN
}

enum ContentType {
  BLOG
  ARTICLE
  PROJECT
  /// Written in the dashboard Notebook (source = WRITTEN). Never used for imported items.
  NOTEBOOK
}

/// Workflow stage. Source of truth; see services/workflow.ts.
enum ContentStatus {
  DRAFT
  VERIFICATION_PENDING
  VERIFIED
  AWAITING_APPROVAL
  PUBLISHED
  REJECTED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum ApprovalStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum VerificationMethod {
  META_TAG
  FILE
}

enum ExtractionStatus {
  NOT_STARTED
  SUCCEEDED
  FAILED
}

// ───────────────────────────── Auth ─────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  role           Role      @default(EDITOR)
  /// Incremented to revoke every existing session (password change, sign out everywhere).
  sessionVersion Int       @default(0) @map("session_version")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  contents  Content[]
  auditLogs AuditLog[]
  assets    Asset[]

  @@map("users")
}

// ─────────────────────────── Content ───────────────────────────

model Content {
  id            String      @id @default(cuid())
  /// Stable public identifier used by the portfolio.
  slug          String      @unique
  title         String
  source        ContentSource @default(IMPORTED)
  /// Original page for IMPORTED items; null for WRITTEN (Notebook) entries.
  url           String?
  /// Canonical form used for duplicate detection (lib/url.ts). Null for WRITTEN entries.
  normalizedUrl String?     @unique @map("normalized_url")
  /// Optional subtitle shown under the title (Notebook entries).
  subtitle      String?
  /// Cover image chosen for a Notebook entry (shown atop the article). Falls back to the first image for `thumbnail`.
  coverImage    String?     @map("cover_image")
  type          ContentType
  description   String?
  thumbnail     String?
  /// Author name as extracted from the page (or entered manually).
  author        String?
  /// Original publication date of the article on its source site.
  publishDate   DateTime?   @map("publish_date")
  featured      Boolean     @default(false)

  // Workflow
  status             ContentStatus      @default(DRAFT)
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  approvalStatus     ApprovalStatus     @default(NOT_SUBMITTED) @map("approval_status")
  verifiedAt         DateTime?          @map("verified_at")
  approvedAt         DateTime?          @map("approved_at")
  publishedAt        DateTime?          @map("published_at")
  rejectedAt         DateTime?          @map("rejected_at")
  rejectionReason    String?            @map("rejection_reason")

  // Extraction
  extractionStatus ExtractionStatus @default(NOT_STARTED) @map("extraction_status")
  extractionError  String?          @map("extraction_error")
  extractedAt      DateTime?        @map("extracted_at")
  finalUrl         String?          @map("final_url")
  canonicalUrl     String?          @map("canonical_url")
  siteName         String?          @map("site_name")
  language         String?
  summary          String?
  contentText      String?          @map("content_text")
  /// Sanitised HTML (sanitize-html allowlist). Never render unsanitised.
  contentHtml      String?          @map("content_html")
  /// Notebook editor document (Tiptap JSON). contentHtml is its server-sanitised rendering.
  body             Json?
  wordCount        Int?             @map("word_count")
  readingMinutes   Int?             @map("reading_minutes")
  images           Json?            @default("[]")
  metadata         Json?            @default("{}")
  contentHash      String?          @map("content_hash")
  /// 64-bit SimHash as 16 hex chars.
  simhash          String?
  duplicateWarnings Json?           @default("[]") @map("duplicate_warnings")

  authorId  String   @map("author_id")
  authorRef User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  tags      Tag[]
  verificationTokens VerificationToken[]
  assets             Asset[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([source])
  @@index([type, status])
  @@index([publishedAt])
  @@index([contentHash])
  @@index([authorId])
  @@map("contents")
}

/// An image uploaded to object storage (Cloudflare R2) from the Notebook editor.
model Asset {
  id           String   @id @default(cuid())
  /// Object key in the bucket, e.g. posts/2026/09/ab12cd34-diagram.png
  key          String   @unique
  url          String
  contentType  String   @map("content_type")
  size         Int
  filename     String?
  /// The entry that uses it (set on save). Null = not (yet) used by any entry.
  contentId    String?  @map("content_id")
  content      Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  uploadedById String   @map("uploaded_by_id")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([contentId])
  @@index([createdAt])
  @@map("assets")
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  contents  Content[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("tags")
}

model VerificationToken {
  id            String             @id @default(cuid())
  contentId     String             @map("content_id")
  content       Content            @relation(fields: [contentId], references: [id], onDelete: Cascade)
  method        VerificationMethod
  token         String             @unique
  expiresAt     DateTime           @map("expires_at")
  attempts      Int                @default(0)
  lastCheckedAt DateTime?          @map("last_checked_at")
  lastError     String?            @map("last_error")
  verifiedAt    DateTime?          @map("verified_at")
  /// Set when superseded by a newer token for the same content item.
  revokedAt     DateTime?          @map("revoked_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([contentId, createdAt])
  @@map("verification_tokens")
}

// ─────────────────────────── System ───────────────────────────

/// Singleton row (id = 1).
model SystemSettings {
  id                Int      @id @default(1)
  allowRegistration Boolean  @default(true) @map("allow_registration")
  siteName          String   @default("My Portfolio") @map("site_name")
  portfolioUrl      String?  @map("portfolio_url")
  /// Minimum words for a page to count as meaningful content.
  minWordCount      Int      @default(150) @map("min_word_count")
  tokenTtlHours     Int      @default(72) @map("token_ttl_hours")
  publicApiEnabled  Boolean  @default(true) @map("public_api_enabled")
  /// Origins allowed to call the public API from a browser (CORS).
  allowedOrigins    String[] @default([]) @map("allowed_origins")

  // Public timeline page (timeline.fahimworks.dev / /timeline)
  timelineEnabled   Boolean  @default(true) @map("timeline_enabled")
  /// false = unlisted (noindex); true = search engines may index the page.
  timelineIndexable Boolean  @default(false) @map("timeline_indexable")
  profileName       String?  @map("profile_name")
  profileTagline    String?  @map("profile_tagline")
  profileGithub     String?  @map("profile_github")
  profileLinkedin   String?  @map("profile_linkedin")
  profileX          String?  @map("profile_x")
  profileWebsite    String?  @map("profile_website")
  profileEmail      String?  @map("profile_email")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
