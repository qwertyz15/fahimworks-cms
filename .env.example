# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://portfolio:change-me@localhost:5432/portfolio?schema=public"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Public base URL of this dashboard. Must be https:// in production.
AUTH_URL="http://localhost:3000"
# Set to true when running behind a trusted reverse proxy (Docker, Vercel, etc).
AUTH_TRUST_HOST="true"

# ─── Security ────────────────────────────────────────────────────────────────
# Comma-separated extra hostnames allowed to invoke Server Actions (only needed
# when a reverse proxy rewrites the Host header), e.g. "cms.example.com".
ALLOWED_ORIGINS=""
# Allow fetching URLs that resolve to private/loopback IPs. NEVER enable in prod.
ALLOW_PRIVATE_NETWORK_FETCH="false"
# Number of trusted proxy hops in front of the app, used to read client IPs
# from X-Forwarded-For for rate limiting. 0 = ignore the header.
TRUSTED_PROXY_HOPS="1"

# ─── Public timeline (optional) ──────────────────────────────────────────────
# Host that serves ONLY the public timeline (no login/dashboard on it), e.g.
# "timeline.fahimworks.dev". Leave empty to serve it only at <AUTH_URL>/timeline.
TIMELINE_HOST=""

# ─── Screenshots (optional) ──────────────────────────────────────────────────
# URL template for a screenshot service used in the content preview.
# {url} is replaced with the URL-encoded page URL. Leave empty to fall back to
# the page's Open Graph image. Examples:
#   https://image.thum.io/get/width/1280/crop/800/noanimate/{url}
#   https://api.microlink.io/?url={url}&screenshot=true&meta=false&embed=screenshot.url
SCREENSHOT_URL_TEMPLATE=""

# ─── Outbound fetching ───────────────────────────────────────────────────────
FETCH_TIMEOUT_MS="10000"
FETCH_MAX_BYTES="5242880"
FETCH_USER_AGENT="PortfolioCMS/1.0 (+content import)"

# ─── Media storage (S3-compatible: Cloudflare R2, MinIO, AWS S3) ────────────
# Used for images, videos and file attachments uploaded in the Notebook editor.
# Leave empty to disable uploads.
#
# Cloudflare R2:
#   S3_ENDPOINT        R2 → bucket → Settings → "S3 API" URL, WITHOUT the
#                      trailing /<bucket>: https://<account-id>.r2.cloudflarestorage.com
#                      (EU-jurisdiction buckets: https://<account-id>.eu.r2.cloudflarestorage.com)
#   S3_REGION          always "auto" for R2
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
#                      R2 → Manage API Tokens → Create Account API Token
#                      (Object Read & Write, limited to this bucket). NOT the "Token value".
#   S3_PUBLIC_URL      The bucket's public custom domain (no trailing slash).
#
# Bucket CORS policy must allow PUT (header: content-type) from the dashboard origin(s).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
# Maximum upload size per image, in bytes (default 10 MB).
UPLOAD_MAX_BYTES="10485760"
# Maximum upload size per video (MP4/WebM) or file attachment, in bytes (default 100 MB).
UPLOAD_MAX_MEDIA_BYTES="104857600"

# ─── docker-compose only ─────────────────────────────────────────────────────
POSTGRES_USER="portfolio"
POSTGRES_PASSWORD=""
POSTGRES_DB="portfolio"
APP_PORT="3000"
# Public hostname for the Caddy HTTPS profile, e.g. "cms.example.com".
DOMAIN=""
